# Copy to .env; never commit a real signing key.
# Generation Method #1: uv run --frozen python -c "import secrets; print(secrets.token_urlsafe(32))"
# Generation Method #2: openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=smartbudget-server
JWT_AUDIENCE=smartbudget-server-api
TOKEN_SECONDS=432000
DATABASE_PATH=./data/smartbudget.sqlite3
HOST=0.0.0.0
PORT=8000
# JSON array of exact origins, e.g. ["http://localhost:3000"]
WEB_ORIGINS=[]
